# Copy to .env and adjust for YOUR demo / JSON-RPC instance.
# These values are read by mcp_server.config.Settings (pydantic-settings).

# Demo / JSON-RPC endpoint used in live (non --demo) mode.
BACKEND_URL=http://localhost:8069

# Restrict the server to read-only operations (recommended). When true, any
# JSON-RPC method not in the allowlist is rejected before it reaches the backend.
READONLY=true

# --- Optional authentication (omit entirely for an unauthenticated demo) ---
# Bearer token sent as `Authorization: Bearer <key>` and as a `api_key` param.
# BACKEND_API_KEY=

# Username / password style auth, forwarded as JSON-RPC params.
# BACKEND_USERNAME=
# BACKEND_PASSWORD=

# Optional database/tenant identifier forwarded as a JSON-RPC param.
# BACKEND_DATABASE=
